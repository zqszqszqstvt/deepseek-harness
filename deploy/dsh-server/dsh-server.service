# systemd unit for dsh server with the cloud runtime contract.
# install-host.sh substitutes @DSH_HOME@, @DATA_DIR@, and @SERVICE_USER@.
#
# Keep the listener on loopback: the Server has no authentication layer, so the
# platform backend owns identity and must derive every URL userId from its
# authenticated principal.

[Unit]
Description=dsh multi-user server (cloud runtime contract)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=@SERVICE_USER@
Group=@SERVICE_USER@

# DSH_HOME holds cordis.patch.yml and credentials. It is outside every sandbox
# namespace, which is why the resident contract lives in the persona row rather
# than in $DSH_HOME/AGENTS.md (that file is never loaded by a Server session).
Environment=DSH_HOME=@DSH_HOME@
# The only host skill root a Server session can read: the provider loads it with
# host filesystem calls and marks it trusted.
Environment=DSH_BUNDLED_SKILL_DIR=/usr/local/share/dsh/skills
# The project HOME is writable, but uv must never fetch another interpreter.
Environment=UV_PYTHON_DOWNLOADS=never
# The model credential. Prefer a drop-in or LoadFile over inlining it here; names
# matching KEY|PASSWORD|SECRET|TOKEN are dropped from every child environment, so
# it never reaches an agent shell.
# Environment=DEEPSEEK_API_KEY=

# The cloud subprocess provider does not inherit service environment entries.
# The Server shell injects its fixed PATH, project HOME, and project caches.

ExecStart=@DSH_BIN@ server --host 127.0.0.1 --port 3080 --data-dir @DATA_DIR@
Restart=on-failure
RestartSec=5

# The sandbox needs to create mount and PID namespaces. Do not add CAP_SYS_ADMIN
# to the unit: bubblewrap creates an unprivileged user namespace, and the host
# must allow it (user.max_user_namespaces nonzero; on Ubuntu 24.04 also
# kernel.apparmor_restrict_unprivileged_userns=0; on an SELinux host in Enforcing
# mode, a policy module rather than a permissive host). If this host's bubblewrap
# is a setuid binary instead, NoNewPrivileges must be dropped for it to work.
NoNewPrivileges=yes
PrivateTmp=yes
PrivateIPC=yes
ProtectHome=yes
ProtectSystem=strict
ProtectProc=invisible
ProcSubset=pid
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictSUIDSGID=yes
LockPersonality=yes
CapabilityBoundingSet=
UMask=0077
# @DATA_DIR@ must stay writable: it holds every user's workspace.
ReadWritePaths=@DATA_DIR@ @DSH_HOME@

[Install]
WantedBy=multi-user.target
